@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Products";
}

@* The script reads its endpoint URLs from these data attributes, so routes are defined only on the server. *@
<div id="products-page"
     data-create-url="@Url.Action("Create", "Products")"
     data-rows-url="@Url.Action("Rows", "Products")">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">Products</h1>
        <button type="button" class="btn btn-primary" id="add-product">Add product</button>
    </div>

    @* Success and "not found" messages appear here. *@
    <div id="product-alerts" aria-live="polite"></div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="text-numeric">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Category</th>
                        <th scope="col" class="text-numeric">Price</th>
                        <th scope="col" class="text-numeric">Stock</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="product-rows">
                    <partial name="_ProductRows" model="Model" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Add/Edit modal. Its content is replaced with the form partial loaded by AJAX. *@
<div class="modal fade" id="product-modal" tabindex="-1" aria-labelledby="product-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content"></div>
    </div>
</div>

@* Delete confirmation modal. The form only provides the anti-forgery token; the script posts it. *@
<div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" id="delete-form">
            <div class="modal-header">
                <h2 class="modal-title h5" id="delete-modal-title">Delete product</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Delete <strong class="js-delete-name"></strong>? This can't be undone.</p>
                <div class="alert alert-danger mt-3 mb-0 d-none js-modal-error" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/products.js" asp-append-version="true"></script>
}
